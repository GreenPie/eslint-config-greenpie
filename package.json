{
  "name": "eslint-config-greenpie",
  "version": "17.15.0",
  "description": "GreenPie's ESLint and oxlint configs",
  "main": "index.js",
  "types": "index.d.ts",
  "author": "Roman Nuritdinov (Ky6uk)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "homepage": "https://github.com/GreenPie/eslint-config-greenpie",
  "repository": {
    "type": "git",
    "url": "https://github.com/GreenPie/eslint-config-greenpie"
  },
  "bugs": {
    "url": "https://github.com/GreenPie/eslint-config-greenpie/issues"
  },
  "scripts": {
    "changeset": "changeset",
    "lint:eslint": "eslint",
    "lint:oxlint": "oxlint",
    "lint:oxlint:agent": "oxlint --format agent",
    "prepare": "husky",
    "release": "changeset publish",
    "test:agent": "vitest run --reporter=agent",
    "test": "vitest run",
    "update:all": "taze -I -l --peer"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "greenpie",
    "config",
    "javascript",
    "styleguide",
    "typescript",
    "vue",
    "oxlint"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "execa": "^10.1.1",
    "husky": "^9.1.7",
    "oxlint": "^1.88.0",
    "taze": "^21.3.0",
    "valibot": "1.5.0",
    "vitest": "^5.0.4",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript-eslint": "^8.71.2"
  }
}
